{
  "name": "ghost-news-bot",
  "version": "3.0.0",
  "description": "Autoblogger for Ghost: AI news articles and evergreen SEO guides, in French.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "news": "node src/index.js --news",
    "guide": "node src/index.js --guide",
    "run": "node src/index.js --run",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "check": "biome check src && tsc --noEmit && node --test \"src/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tryghost/admin-api": "^1.14.14",
    "dotenv": "^18.0.9",
    "node-cron": "^4.6.0",
    "openai": "^7.47.0",
    "unsplash-js": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
